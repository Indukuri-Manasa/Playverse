# Frontend (read at build time by Vite). Set this on Vercel when the game server is hosted elsewhere.
# Leave empty for local development (Vite proxies /socket.io to the local server).
VITE_GAME_SERVER_URL=

# Game server (server/index.js) — set these on the server host, not on Vercel.
# CORS_ORIGINS=https://playverse-beta.vercel.app
# PORT=3001            (most hosts set this automatically)
